--- !u!114 &1264518629
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1264518627}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MP2B \u2014 INDIVIDUAL RUBRIC EVIDENCE\r\n\r\nMASTERy THRESHOLDING \u2014
    21 Thresholds \u2014 7 pts\r\n1  Harvest \u2192 Processing \u2192 Selling \u2192
    Upgrade progression\r\n2  Mining Head Lv1\u20135 unlocks Slate / Frost / Basalt
    / Abyssal / Crystal\r\n3  Storage Lv1\u20138, Engineer Lv0\u20133, Power Lv0\u20134\r\n4 
    Walls Lv0\u20138, Weapons Lv0\u20138\r\n\r\nERROR TOLERANT LESSONS \u2014 21
    Catches \u2014 7 pts\r\n5  Locked upgrades explain WHY they fail and HOW to progress\r\n6 
    Includes threshold gates, insufficient credits, max level, locked mechanics\r\n\r\nTHRESHOLDS
    ON THE HORIZON \u2014 2 pts\r\n7  Next objective appears only after the previous
    threshold is cleared\r\n\r\nUNLOCK REVEALS \u2014 9 Reveals \u2014 4 pts\r\n8 
    Processing / Selling / Engineering Console\r\n9  Mining Head / Storage / Engineer
    / Power / Walls / Weapons\r\n10 Reveal text appears BEFORE the new button or
    affordance becomes available\r\n\r\nGAMEPLAY EVIDENCE\r\n11 Mining Head level
    determines which asteroid families can be targeted\r\n12 Highest-value valid
    asteroid is automatically selected\r\n13 Credits \u2192 Upgrades \u2192 Stats
    / Capacity / Modules / New Capabilities\r\n\r\nTOTAL TARGET: 20 pts + Interconnection
    / Collaboration \u2192 22 pt cap"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
