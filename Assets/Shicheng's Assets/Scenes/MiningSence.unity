--- !u!114 &1174427492
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1174427490}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "21 Distinct Interaction Catches\n\n1. Premature Storage Upgrade \u2014
    Storage Lv.2 is locked until Threshold 5. Complete Threshold 4 first.\n2. Premature
    Engineer Upgrade \u2014 Engineer Lv.2 unlocks after Threshold 5. Complete Storage
    Lv.2 first.\n3. Premature Power Upgrade \u2014 Power Lv.1 unlocks after Threshold
    6. Complete Engineer Lv.2 first.\n4. Premature Mining Head Upgrade \u2014 Mining
    Head Lv.3 unlocks after Threshold 7. Complete Power Lv.1 first.\n5. Premature
    Storage Upgrade II \u2014 Storage Lv.4 unlocks after Threshold 8. Complete Mining
    Head Lv.3 first.\n6. Premature Walls Upgrade \u2014 Walls Lv.1 unlocks after
    Threshold 9. Complete Storage Lv.4 and Power Lv.2 first.\n7. Premature Mining
    Head Upgrade II \u2014 Mining Head Lv.4 unlocks after Threshold 10. Complete
    Walls Lv.1 first.\n8. Premature Weapons Upgrade \u2014 Weapons Lv.1 unlocks after
    Threshold 11. Complete Mining Head Lv.4 first.\n9. Premature Storage Upgrade
    III \u2014 Storage Lv.6 unlocks after Threshold 12. Complete Weapons Lv.1 first.\n10.
    Premature Engineer Upgrade II \u2014 Engineer Lv.3 unlocks after Threshold 13.
    Complete Storage Lv.6, Walls Lv.2, and Weapons Lv.2 first.\n11. Premature Power
    Upgrade II \u2014 Power Lv.3 unlocks after Threshold 14. Complete Engineer Lv.3,
    Walls Lv.3, and Weapons Lv.3 first.\n12. Premature Storage Upgrade IV \u2014
    Storage Lv.7 unlocks after Threshold 15. Complete Power Lv.3, Walls Lv.4, and
    Weapons Lv.4 first.\n13. Premature Power Upgrade III \u2014 Power Lv.4 unlocks
    after Threshold 16. Complete Storage Lv.7 first.\n14. Premature Storage Upgrade
    V \u2014 Storage Lv.8 unlocks after Threshold 17. Complete Power Lv.4 first.\n15.
    Premature Mining Head Upgrade III \u2014 Mining Head Lv.5 unlocks after Threshold
    18. Complete Storage Lv.8 first.\n16. Premature Walls Upgrade II \u2014 Walls
    Lv.6 unlocks after Threshold 19. Complete Mining Head Lv.5 first.\n17. Premature
    Walls Upgrade III \u2014 Walls Lv.8 unlocks after Threshold 20. Complete Walls
    Lv.6 and Weapons Lv.6 first.\n\n18. Upgrade Panel Locked \u2014 Upgrades unlock
    after the first sale. Harvest, process, and sell barrels first.\n19. Insufficient
    Credits \u2014 Not enough Credits. Sell more barrels to earn the required amount.\n20.
    Maximum Upgrade Level \u2014 This upgrade is already at its maximum level. Select
    another upgrade.\n21. No Valid Mining Target \u2014 No harvestable asteroid is
    available. Move into range or unlock the asteroid's family with Mining Head upgrades."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
