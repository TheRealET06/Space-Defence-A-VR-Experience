  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "21 Mastery Thresholds\n\n1. First Harvest \u2014 Harvest your first asteroid.\n2.
    First Processing \u2014 Unload cargo and process the first barrels.\n3. First
    Sale \u2014 Sell barrels and earn Credits.\n\n4. Starter Upgrades \u2014 Reach
    Mining Head Lv.2, Storage Lv.1, and Engineer Lv.1.\n5. Storage Expansion \u2014
    Reach Storage Lv.2.\n6. Engineering Upgrade \u2014 Reach Engineer Lv.2.\n7. Power
    Upgrade \u2014 Reach Power Lv.1.\n8. Basalt Mining \u2014 Reach Mining Head Lv.3
    to unlock Basalt asteroids.\n9. Storage & Power \u2014 Reach Storage Lv.4 and
    Power Lv.2.\n10. Defensive Walls \u2014 Reach Walls Lv.1.\n\n11. Abyssal Mining
    \u2014 Reach Mining Head Lv.4 to unlock Abyssal asteroids.\n12. Weapons Online
    \u2014 Reach Weapons Lv.1.\n13. Fortified Infrastructure \u2014 Reach Storage
    Lv.6, Walls Lv.2, and Weapons Lv.2.\n14. Advanced Engineering \u2014 Reach Engineer
    Lv.3, Walls Lv.3, and Weapons Lv.3.\n15. Power & Defense \u2014 Reach Power Lv.3,
    Walls Lv.4, and Weapons Lv.4.\n16. Storage Expansion II \u2014 Reach Storage
    Lv.7.\n17. Power Upgrade II \u2014 Reach Power Lv.4.\n18. Maximum Storage \u2014
    Reach Storage Lv.8.\n\n19. Crystal Mining \u2014 Reach Mining Head Lv.5 to unlock
    Crystal asteroids.\n20. Advanced Defense \u2014 Reach Walls Lv.6 and Weapons
    Lv.6.\n21. Maximum Defense \u2014 Reach Walls Lv.8 and Weapons Lv.8."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
